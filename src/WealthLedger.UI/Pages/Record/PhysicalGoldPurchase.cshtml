@page "/record/physical-gold-purchase"
@model WealthLedger.UI.Pages.Record.PhysicalGoldPurchaseModel
@inject UiText Text
@using WealthLedger.Application.PhysicalGold
@{
    Layout = "/Pages/Shared/_ShellLayout.cshtml";
    ViewData["Title"] = Text["GoldPurchase_Title"];
    ViewData["ActiveNavigation"] = "Record";
}

<article class="flow" aria-labelledby="gold-purchase-heading">
    <header class="page-heading">
        <p class="eyebrow">@Text["Gold_Eyebrow"]</p>
        <h1 id="gold-purchase-heading">@Text["GoldPurchase_Title"]</h1>
        <p class="lede">@Text["GoldPurchase_Introduction"]</p>
    </header>

    <partial name="_ValidationSummary" />

    @if (!string.IsNullOrWhiteSpace(Model.HouseholdStateResourceKey))
    {
        <section class="summary-card summary-card--warning flow" role="alert">
            <h2>@Text["Ready_Household_StateTitle"]</h2>
            <p>@Text[Model.HouseholdStateResourceKey]</p>
        </section>
    }
    else if (Model.LoadUnavailable || Model.Choices is null)
    {
        <section class="summary-card summary-card--warning flow" role="alert">
            <h2>@Text["Gold_LoadErrorTitle"]</h2>
            <p>@Text["Gold_LoadErrorExplanation"]</p>
        </section>
    }
    else
    {
        @if (Model.ChoicesAreTruncated)
        {
            <section class="summary-card summary-card--warning flow" role="status">
                <h2>@Text["Gold_ChoicesTruncatedTitle"]</h2>
                <p>@Text["Gold_ChoicesTruncatedExplanation"]</p>
            </section>
        }

        <form method="post" class="flow" novalidate>
            @if (Model.IsReview && Model.Preview is not null)
            {
                <partial name="_PhysicalGoldHiddenForm" model="Model" />
                var preview = Model.Preview;
                var economics = preview.Economics;

                <section class="panel review-panel flow" aria-labelledby="gold-purchase-review-heading">
                    <p class="status-mark">@Text["Gold_ReviewStatus"]</p>
                    <h2 id="gold-purchase-review-heading">@Text["Gold_ReviewTitle"]</h2>
                    <p>@Text["GoldPurchase_ReviewExplanation"]</p>

                    <dl class="fact-grid">
                        <div><dt>@Text["Gold_GoldAccountLabel"]</dt><dd>@preview.GoldAccountName</dd></div>
                        <div><dt>@Text["Gold_CashAccountLabel"]</dt><dd>@preview.CashAccountName</dd></div>
                        <div><dt>@Text["Gold_AssetLabel"]</dt><dd>@preview.GoldAssetName (@preview.GoldAssetCode)</dd></div>
                        <div><dt>@Text["Gold_ExecutionDateLabel"]</dt><dd>@Model.Values.BusinessDate(preview.ExecutionDate).Text</dd></div>
                        <div><dt>@Text["Gold_GrossWeightLabel"]</dt><dd>@Model.PresentGross(preview.GrossWeightRawE8).Text</dd></div>
                        <div><dt>@Text["Gold_FinenessLabel"]</dt><dd>@Model.PresentFineness(preview.FinenessPpm)</dd></div>
                        <div><dt>@Text["Gold_FineWeightLabel"]</dt><dd>@Model.PresentFineWeight(preview.FineWeightGrams)</dd></div>
                        <div><dt>@Text["Gold_PieceCountLabel"]</dt><dd>@preview.PieceCount</dd></div>
                        <div><dt>@Text["Gold_ConsiderationLabel"]</dt><dd>@Model.PresentMoney(economics.CashConsideration!.MinorUnits, preview.CurrencyCode, preview.MinorUnitDigits).Text</dd></div>
                        <div><dt>@Text["Gold_AdditionalOutflowLabel"]</dt><dd>@Model.PresentMoney(economics.AdditionalCashOutflowTotal.MinorUnits, preview.CurrencyCode, preview.MinorUnitDigits).Text</dd></div>
                        <div><dt>@Text["Gold_NetCashEffectLabel"]</dt><dd>@Model.PresentMoney(economics.NetCashEffect.MinorUnits, preview.CurrencyCode, preview.MinorUnitDigits).Text</dd></div>
                        <div><dt>@Text["Gold_AcquisitionCostLabel"]</dt><dd>@Model.PresentMoney(economics.AcquisitionLotCost!.MinorUnits, preview.CurrencyCode, preview.MinorUnitDigits).Text</dd></div>
                        <div><dt>@Text["Gold_CounterpartyLabel"]</dt><dd>@(preview.CounterpartyName ?? Text["State_Unknown"])</dd></div>
                    </dl>

                    @if (preview.ExecutedUnitPriceRawE8 is long executedPrice
                         && preview.Economics.PriceImpliedGross is not null)
                    {
                        <h3>@Text["Gold_PriceComparisonTitle"]</h3>
                        <dl class="fact-grid">
                            <div><dt>@Text["Gold_UnitPriceLabel"]</dt><dd>@Model.Values.UnitPrice(executedPrice, preview.CurrencyCode).Text</dd></div>
                            <div><dt>@Text["Gold_PriceImpliedLabel"]</dt><dd>@Model.PresentMoney(preview.Economics.PriceImpliedGross.MinorUnits, preview.CurrencyCode, preview.MinorUnitDigits).Text</dd></div>
                            <div><dt>@Text["Gold_DiscrepancyLabel"]</dt><dd>@Model.PresentMoney(preview.Economics.DiscrepancyMinorUnits ?? 0, preview.CurrencyCode, preview.MinorUnitDigits).Text</dd></div>
                        </dl>
                    }

                    @if (preview.Costs.Count > 0)
                    {
                        <h3>@Text["Gold_CostsTitle"]</h3>
                        <table class="data-table">
                            <thead><tr><th scope="col">@Text["Gold_CostTypeLabel"]</th><th scope="col">@Text["Gold_CostTreatmentLabel"]</th><th scope="col">@Text["Gold_CostAmountLabel"]</th></tr></thead>
                            <tbody>
                            @foreach (var cost in preview.Costs)
                            {
                                <tr>
                                    <td data-label="@Text["Gold_CostTypeLabel"]"><code>@PhysicalGoldCodes.ToCostTypeCode(cost.Type)</code></td>
                                    <td data-label="@Text["Gold_CostTreatmentLabel"]"><code>@PhysicalGoldCodes.ToTreatmentCode(cost.Treatment)</code></td>
                                    <td data-label="@Text["Gold_CostAmountLabel"]">@Model.PresentMoney(cost.Amount.MinorUnits, preview.CurrencyCode, preview.MinorUnitDigits).Text</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }

                    @if (preview.WarningCodes.Count > 0)
                    {
                        <section class="summary-card summary-card--warning flow" role="status">
                            <h3>@Text["Gold_WarningsTitle"]</h3>
                            <ul class="plain-list">
                            @foreach (var warning in preview.WarningCodes)
                            {
                                <li>@Text[$"Gold_Warning_{warning}"]</li>
                            }
                            </ul>
                        </section>
                    }

                    <button class="button" type="submit" asp-page-handler="Post" data-final-submit>
                        @Text["GoldPurchase_PostAction"]
                    </button>
                    <a class="card-link" asp-page="/Record/PhysicalGoldPurchase">@Text["Gold_EditAction"]</a>
                </section>
            }
            else
            {
                <input type="hidden" asp-for="Input.IdempotencyKey" />
                <partial name="_PhysicalGoldFields" model="Model" />
                <button class="button" type="submit" asp-page-handler="Review">@Text["Gold_ReviewAction"]</button>
            }
        </form>
    }
</article>
