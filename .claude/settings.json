{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DOTNET_CLI_UI_LANGUAGE": "en"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet tool restore *)",
      "PowerShell(dotnet tool restore *)",
      "Bash(dotnet restore *)",
      "PowerShell(dotnet restore *)",
      "Bash(dotnet build *)",
      "PowerShell(dotnet build *)",
      "Bash(dotnet test *)",
      "PowerShell(dotnet test *)",
      "Bash(dotnet format *)",
      "PowerShell(dotnet format *)",
      "Bash(dotnet ef migrations has-pending-model-changes *)",
      "PowerShell(dotnet ef migrations has-pending-model-changes *)",
      "Bash(dotnet ef migrations add *)",
      "PowerShell(dotnet ef migrations add *)",
      "Bash(pwsh tests/WealthLedger.UI.BrowserTests/bin/Debug/net10.0/playwright.ps1 install *)",
      "PowerShell(pwsh tests/WealthLedger.UI.BrowserTests/bin/Debug/net10.0/playwright.ps1 install *)",
      "Bash(git status *)",
      "PowerShell(git status *)",
      "Bash(git diff *)",
      "PowerShell(git diff *)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git show *)",
      "PowerShell(git show *)",
      "Bash(git grep *)",
      "PowerShell(git grep *)",
      "Bash(git ls-files *)",
      "PowerShell(git ls-files *)",
      "Bash(git rev-parse *)",
      "PowerShell(git rev-parse *)",
      "Bash(git merge-base *)",
      "PowerShell(git merge-base *)",
      "Bash(git branch --show-current)",
      "PowerShell(git branch --show-current)",
      "Bash(git branch --list *)",
      "PowerShell(git branch --list *)",
      "Bash(git branch -m *)",
      "PowerShell(git branch -m *)",
      "Bash(git stash list *)",
      "PowerShell(git stash list *)",
      "Bash(git worktree list *)",
      "PowerShell(git worktree list *)",
      "Bash(git worktree add *)",
      "PowerShell(git worktree add *)",
      "Bash(git fetch *)",
      "PowerShell(git fetch *)",
      "Bash(git pull --ff-only *)",
      "PowerShell(git pull --ff-only *)",
      "Bash(git switch -c *)",
      "PowerShell(git switch -c *)",
      "Bash(git checkout -b *)",
      "PowerShell(git checkout -b *)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(gh repo view *)",
      "PowerShell(gh repo view *)",
      "Bash(gh issue view *)",
      "PowerShell(gh issue view *)",
      "Bash(gh issue list *)",
      "PowerShell(gh issue list *)",
      "Bash(gh pr view *)",
      "PowerShell(gh pr view *)",
      "Bash(gh pr list *)",
      "PowerShell(gh pr list *)",
      "Bash(gh pr checks *)",
      "PowerShell(gh pr checks *)",
      "Bash(gh pr diff *)",
      "PowerShell(gh pr diff *)",
      "Bash(gh run view *)",
      "PowerShell(gh run view *)",
      "Bash(gh run list *)",
      "PowerShell(gh run list *)"
    ],
    "ask": [
      "Bash(dotnet run *)",
      "PowerShell(dotnet run *)",
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git * push *)",
      "PowerShell(git * push *)",
      "Bash(git fetch --prune *)",
      "PowerShell(git fetch --prune *)",
      "Bash(git fetch -p *)",
      "PowerShell(git fetch -p *)",
      "Bash(git remote prune *)",
      "PowerShell(git remote prune *)",
      "Bash(git branch -d *)",
      "PowerShell(git branch -d *)",
      "Bash(git branch -D *)",
      "PowerShell(git branch -D *)",
      "Bash(git branch --delete *)",
      "PowerShell(git branch --delete *)",
      "Bash(git worktree remove *)",
      "PowerShell(git worktree remove *)",
      "Bash(git worktree prune *)",
      "PowerShell(git worktree prune *)",
      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Bash(git restore *)",
      "PowerShell(git restore *)",
      "Bash(git checkout -- *)",
      "PowerShell(git checkout -- *)",
      "Bash(git stash drop *)",
      "PowerShell(git stash drop *)",
      "Bash(git stash clear *)",
      "PowerShell(git stash clear *)",
      "Bash(git update-ref -d *)",
      "PowerShell(git update-ref -d *)",
      "Bash(rm *)",
      "PowerShell(rm *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(del *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(gh pr comment *)",
      "PowerShell(gh pr comment *)",
      "Bash(gh pr review *)",
      "PowerShell(gh pr review *)",
      "Bash(gh pr edit *)",
      "PowerShell(gh pr edit *)",
      "Bash(gh pr close *)",
      "PowerShell(gh pr close *)",
      "Bash(gh issue create *)",
      "PowerShell(gh issue create *)",
      "Bash(gh issue edit *)",
      "PowerShell(gh issue edit *)",
      "Bash(gh issue comment *)",
      "PowerShell(gh issue comment *)",
      "Bash(gh issue close *)",
      "PowerShell(gh issue close *)",
      "Bash(gh issue delete *)",
      "PowerShell(gh issue delete *)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/docs/PROJECT_STATE.md)",
      "Edit(/docs/milestones/M002_*.md)",
      "Edit(/docs/milestones/M003_*.md)",
      "Edit(/docs/milestones/M004_*.md)",
      "Edit(/docs/milestones/M005_*.md)",
      "Edit(/docs/milestones/M006_*.md)",
      "Edit(/docs/milestones/M007_*.md)",
      "Edit(/docs/milestones/M008_*.md)",
      "Edit(/docs/milestones/M009_*.md)",
      "Edit(/docs/decisions/ADR-*.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/launch.json)"
    ],
    "deny": [
      "Bash(dotnet watch *)",
      "PowerShell(dotnet watch *)",
      "Read(/src/**/Properties/launchSettings.json)",
      "Read(~/AppData/Local/WealthLedger/**)",
      "Edit(/docs/history/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-real-data.sh\" || exit 2",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
